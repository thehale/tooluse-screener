# Usage: bin/gofmtcheck

set -euo pipefail

main() {
	local unformatted
	unformatted="$(gofmt -l .)"

	if [[ -n "$unformatted" ]]; then
		echo "Not formatted with gofmt:"
		echo "$unformatted"
		exit 1
	fi
}

main "$@"
