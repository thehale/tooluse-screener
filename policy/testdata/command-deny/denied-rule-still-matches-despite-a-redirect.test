denied:
  - name: Remove
    patterns:
      - '^rm\b'
allowed:
  - name: Remove notes.txt
    patterns:
      - '^rm notes\.txt$'
--------------------------------------------------------------------------------
$ROOT % rm -rf notes.txt 2>&1
deny: Command matches a denied rule: Remove
