denied:
  - name: Remove
    patterns:
      - '^rm\b'
allowed:
  - cat
  - echo
--------------------------------------------------------------------------------
$ROOT % echo "$(cat <<'EOF'\nrm -rf notes\nEOF\n)"
deny: Command matches a denied rule: Remove
