denied:
  - git config --unset
--------------------------------------------------------------------------------
$ROOT % git config --unset user.name
deny: Command matches a denied rule: git config --unset

$ROOT % git -C /x config --global --unset user.name
deny: Command matches a denied rule: git config --unset
