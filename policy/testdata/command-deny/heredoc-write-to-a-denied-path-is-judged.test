denied:
  - name: Shell profile
    paths:
      - '~/.bashrc'
allowed:
  - cat
--------------------------------------------------------------------------------
$ROOT % cat <<'EOF' >> ~/.bashrc\nrm -rf notes\nEOF
deny: Path matches a denied rule: Shell profile
