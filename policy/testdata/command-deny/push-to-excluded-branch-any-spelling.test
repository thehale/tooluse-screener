trusted_git_directories:
  - $ROOT
denied:
  - name: Push
    commands: git push
allowed:
  - name: Push where CI can run it
    patterns:
      - '^git (-C \S+ )?push origin \S+$'
    only:
      dirs:
        - $ROOT
      branches:
        - not:
            - main
            - master
            - trunk
--------------------------------------------------------------------------------
$ROOT % git -C $ROOT push origin main
deny: Command matches a denied rule: Push

$ROOT % git -C $ROOT push origin HEAD:main
deny: Command matches a denied rule: Push

$ROOT % git -C $ROOT push origin refs/heads/trunk
deny: Command matches a denied rule: Push

$ROOT % git -C $ROOT push origin MASTER
deny: Command matches a denied rule: Push
