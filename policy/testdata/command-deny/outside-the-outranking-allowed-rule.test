trusted_git_directories:
  - $ROOT
denied:
  - name: Push
    commands: git push
allowed:
  - name: Push where CI can run it
    patterns:
      - '^git -C \S+ push origin \S+$'
    only:
      dirs:
        - $ROOT
      branches:
        - not: main
--------------------------------------------------------------------------------
$ROOT % git -C $ROOT push origin main
deny: Command matches a denied rule: Push

$ROOT % git -C $ROOT push
deny: Command matches a denied rule: Push

$ROOT % git -C /elsewhere push origin topic
deny: Command matches a denied rule: Push
