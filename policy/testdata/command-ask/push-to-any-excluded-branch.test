allowed:
  - patterns:
      - '^git push origin \S+$'
    only:
      branches:
        - not: main
        - not:
            - release
--------------------------------------------------------------------------------
$ROOT % git push origin main
ask: no automatic policy found for command

$ROOT % git push origin release
ask: no automatic policy found for command
