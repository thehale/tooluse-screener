trusted_git_directories:
  - /work
allowed:
  - git status
--------------------------------------------------------------------------------
# A place the shell decides is known to no rule
$ROOT % cd "$REPO" && git status
ask: Command is not in the shared allow list

$ROOT % cd - && git status
ask: Command is not in the shared allow list
