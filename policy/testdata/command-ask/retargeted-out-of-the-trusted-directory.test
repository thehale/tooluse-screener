trusted_git_directories:
  - /work
allowed:
  - git status
--------------------------------------------------------------------------------
# Git reads GIT_DIR, GIT_WORK_TREE and GIT_COMMON_DIR as the options they stand
# for, and an assignment is what takes the command out of the trusted directory
$ROOT % GIT_DIR=/elsewhere/.git git status
ask: no automatic policy found for command

$ROOT % GIT_WORK_TREE=/elsewhere git -C /work status
ask: no automatic policy found for command

$ROOT % GIT_COMMON_DIR=/elsewhere git -C /work status
ask: no automatic policy found for command
