denied:
  - commands: git push
    addendum:
      - only:
          dirs:
            - $ROOT
        reason: Push your own branch by name.
--------------------------------------------------------------------------------
$ROOT % git -C $ROOT push
deny: Command matches a denied rule: git push. Push your own branch by name.
