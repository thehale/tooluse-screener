denied:
  - commands:
      - shutdown
    patterns:
      - '\breboot\b'
    name: Take the machine down
--------------------------------------------------------------------------------
$ROOT % shutdown now
deny: Command matches a denied rule: Take the machine down

$ROOT % reboot now
deny: Command matches a denied rule: Take the machine down
