denied:
  - paths:
      - secrets/**
allowed:
  - cd
  - make
--------------------------------------------------------------------------------
$ROOT % cd "$d" && make
allow: Every command is allowed: cd, make

$ROOT % cd "$d" && make > /dev/null
allow: Every command is allowed: cd, make
