denied:
  - paths:
      - '~/.ssh/**'
      - '~/**/*.pem'
--------------------------------------------------------------------------------
$ROOT % Edit(/home/me/src/tls/client.pem.bak)
ask: Path is not in the shared allow list

$ROOT % Edit(/home/me/.sshd/config)
ask: Path is not in the shared allow list
